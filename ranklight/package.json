{
  "name": "ranklight",
  "version": "0.1.0",
  "private": true,
  "description": "Ranklight: self-hosted SEO keyword rank tracker",
  "type": "module",
  "main": "server/index.js",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "seed": "node --no-warnings server/seed.js",
    "test": "node --no-warnings --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
